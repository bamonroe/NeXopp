<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Audio-annotated strokes: recording the .wav sidecar a stroke's fn/ts points into. Requested
         at runtime the first time the user hits Record; the app is fully usable without it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeXopp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.NeXopp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer the app as a handler for our own two formats. Both .xopp and .rnote are
                 gzip containers, so application/gzip (and its legacy x-gzip spelling) is what a
                 provider realistically reports for them; DocumentIo sniffs the real kind from the
                 leading bytes once it's handed over. application/octet-stream is deliberately NOT
                 registered — it would offer NeXopp for every unknown binary file on the device. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/gzip" />
                <data android:scheme="content" android:mimeType="application/x-gzip" />
            </intent-filter>

            <!-- Fallback for senders that hand over a file:// URI with no (or a generic)
                 MIME type — match on the .xopp/.rnote extension instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.xopp" />
                <data android:pathPattern=".*\\..*\\.xopp" />
                <data android:pathPattern=".*\\..*\\..*\\.xopp" />
                <data android:pathPattern=".*\\.XOPP" />
                <data android:pathPattern=".*\\..*\\.XOPP" />
                <data android:pathPattern=".*\\..*\\..*\\.XOPP" />
                <data android:pathPattern=".*\\.rnote" />
                <data android:pathPattern=".*\\..*\\.rnote" />
                <data android:pathPattern=".*\\..*\\..*\\.rnote" />
                <data android:pathPattern=".*\\.RNOTE" />
                <data android:pathPattern=".*\\..*\\.RNOTE" />
                <data android:pathPattern=".*\\..*\\..*\\.RNOTE" />
            </intent-filter>

            <!-- Offer the app as a PDF handler: open/annotate a PDF handed over by a file
                 manager, browser, or mail client. Content and file URIs are covered
                 separately because a provider-backed content:// URI carries its MIME type
                 while a bare file:// URI often doesn't. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Fallback for senders that hand over a file:// URI with no (or a generic)
                 MIME type — match on the .pdf extension instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\..*\\.pdf" />
                <data android:pathPattern=".*\\..*\\..*\\.pdf" />
            </intent-filter>

            <!-- Offer the app as a plain-text handler too: a .txt or .md file is typeset into a
                 generated PDF and opened as an annotatable document. Same content/file split as
                 the PDF filters above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="file" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="file" android:mimeType="text/markdown" />
            </intent-filter>

            <!-- Fallback for senders that hand over a file:// URI with no (or a generic)
                 MIME type — match on the .txt/.md extension instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\..*\\.md" />
                <data android:pathPattern=".*\\..*\\..*\\.md" />
            </intent-filter>

            <!-- Offer the app as an image handler: a PNG/JPEG/WebP opens as a one-page document
                 with the picture as the page background. Same content/file split as above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="image/png" />
                <data android:scheme="file" android:mimeType="image/png" />
                <data android:scheme="content" android:mimeType="image/jpeg" />
                <data android:scheme="file" android:mimeType="image/jpeg" />
                <data android:scheme="content" android:mimeType="image/webp" />
                <data android:scheme="file" android:mimeType="image/webp" />
            </intent-filter>

            <!-- Fallback for senders that hand over a file:// URI with no (or a generic)
                 MIME type — match on the image extension instead. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.png" />
                <data android:pathPattern=".*\\..*\\.png" />
                <data android:pathPattern=".*\\..*\\..*\\.png" />
                <data android:pathPattern=".*\\.jpg" />
                <data android:pathPattern=".*\\..*\\.jpg" />
                <data android:pathPattern=".*\\..*\\..*\\.jpg" />
                <data android:pathPattern=".*\\.jpeg" />
                <data android:pathPattern=".*\\..*\\.jpeg" />
                <data android:pathPattern=".*\\..*\\..*\\.jpeg" />
                <data android:pathPattern=".*\\.webp" />
                <data android:pathPattern=".*\\..*\\.webp" />
                <data android:pathPattern=".*\\..*\\..*\\.webp" />
            </intent-filter>
        </activity>
    </application>

</manifest>
